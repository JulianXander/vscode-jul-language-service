{
	"comments": {
		"lineComment": "#"
	},
	"brackets": [
		[
			"(",
			")"
		],
		[
			"[",
			"]"
		]
	],
	"autoClosingPairs": [
		{
			"open": "(",
			"close": ")"
		},
		{
			"open": "[",
			"close": "]"
		},
		{
			"open": "§",
			"close": "§",
			"notIn": [
				"string"
			]
		}
	],
	"autoCloseBefore": ";:.,=}])>` \n\t",
	"surroundingPairs": [
		[
			"(",
			")"
		],
		[
			"[",
			"]"
		],
		[
			"§",
			"§"
		]
	],
	"folding": {
		"markers": {
			"start": "s*#region\\b",
			"end": "s*#endregion\\b"
		}
	},
	"wordPattern": "[a-zA-Z][0-9a-zA-Z]*\\$?",
	"indentationRules": {
		"increaseIndentPattern": "(=>|\\?|\\(|\\[)$",
		"decreaseIndentPattern": "^\\s*[\\)\\]]"
	}
}